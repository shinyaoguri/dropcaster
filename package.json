{
  "name": "@dropcaster/viewer",
  "version": "1.0.0",
  "description": "A static PWA generator for creative coding sketches",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dropcaster": "./cli/index.js"
  },
  "files": [
    "dist",
    "cli",
    "scripts",
    "src",
    "public/assets",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "dev": "npm run scan:previews && vite",
    "build": "tsc && vite build",
    "preview": "vite preview dist",
    "scan": "node scripts/scan-sketches.js 2>/dev/null > public/sketches.json && echo '📁 スケッチリストを更新しました'",
    "scan:previews": "node scripts/scan-sketches.js --generate-previews",
    "scan:full": "node scripts/scan-sketches.js --generate-previews --fetch-user-data",
    "scan:reset": "rm -rf public/sketches public/previews public/avatars && node scripts/scan-sketches.js --generate-previews --fetch-user-data --force-regenerate && echo '🔄 公開ファイルをリセット・再生成しました'",
    "scan:watch": "nodemon --watch sketches --ext html,js,css --exec \"npm run scan\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "nodemon": "^3.0.2",
    "playwright": "^1.47.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "~5.8.3",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "axios": "^1.11.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ora": "^7.0.1",
    "prompts": "^2.4.2",
    "puppeteer": "^24.16.2"
  }
}
