{
  "name": "dropcaster",
  "version": "0.1.0",
  "description": "A static PWA generator for creative coding sketches",
  "keywords": [
    "openprocessing",
    "p5js",
    "creative-coding",
    "pwa",
    "gallery",
    "static-site-generator"
  ],
  "homepage": "https://github.com/shinyaoguri/dropcaster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinyaoguri/dropcaster.git"
  },
  "bugs": {
    "url": "https://github.com/shinyaoguri/dropcaster/issues"
  },
  "author": "Shinya Oguri",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "src/cli/index.js",
  "bin": {
    "dropcaster": "./src/cli/index.js"
  },
  "files": [
    "src",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "postinstall": "node src/core/postinstall.js",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "prebuild": "node scripts/sync-sw.js",
    "build": "tsc && vite build",
    "preview": "vite preview dist",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "prebuild:web": "node scripts/sync-sw.js",
    "build:web": "tsc && vite build --config apps/web/vite.config.ts",
    "preview:web": "vite preview --config apps/web/vite.config.ts",
    "scan": "node src/core/scan-sketches.js --generate-previews --fetch-userdata --write-file",
    "scan:reset": "node src/core/scan-sketches.js --generate-previews --fetch-userdata --write-file --reset",
    "scan:watch": "nodemon --watch sketches --ext html,js,css --exec \"node src/core/scan-sketches.js --watch-mode --write-file\"",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260517.1",
    "nodemon": "^3.0.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "ora": "^9.4.0",
    "playwright": "^1.47.0",
    "prompts": "^2.4.2",
    "terser": "^5.43.1",
    "vite": "^8.0.11"
  }
}
