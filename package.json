{
  "name": "dropcaster",
  "version": "0.1.0",
  "description": "A static PWA generator for creative coding sketches",
  "keywords": [
    "openprocessing",
    "p5js",
    "creative-coding",
    "pwa",
    "gallery",
    "static-site-generator"
  ],
  "homepage": "https://github.com/shinyaoguri/dropcaster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinyaoguri/dropcaster.git"
  },
  "bugs": {
    "url": "https://github.com/shinyaoguri/dropcaster/issues"
  },
  "author": "Shinya Oguri",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "cli/index.js",
  "bin": {
    "dropcaster": "./cli/index.js"
  },
  "files": [
    "cli",
    "scripts",
    "src",
    "public/assets",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "postinstall": "playwright install chromium",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview dist",
    "scan": "node scripts/scan-sketches.js --generate-previews --fetch-user-data --write-file",
    "scan:reset": "rm -rf public/sketches public/previews && node scripts/scan-sketches.js --generate-previews --fetch-user-data --write-file --force-regenerate",
    "scan:watch": "nodemon --watch sketches --ext html,js,css --exec \"node scripts/scan-sketches.js --watch-mode --write-file\""
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "axios": "^1.11.0",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "ora": "^9.4.0",
    "playwright": "^1.47.0",
    "prompts": "^2.4.2",
    "terser": "^5.43.1",
    "vite": "^8.0.11"
  }
}
