{
  "name": "dropcaster",
  "version": "0.1.0",
  "description": "A static PWA generator for creative coding sketches",
  "keywords": [
    "openprocessing",
    "p5js",
    "creative-coding",
    "pwa",
    "gallery",
    "static-site-generator"
  ],
  "homepage": "https://github.com/yourusername/dropcaster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/dropcaster.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/dropcaster/issues"
  },
  "author": "Shinya Oguri",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dropcaster": "./cli/index.js"
  },
  "files": [
    "dist",
    "cli",
    "scripts",
    "src",
    "public/assets",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "postinstall": "npx playwright install chromium",
    "prepublishOnly": "npm run build",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview dist",
    "scan": "node scripts/scan-sketches.js 2>/dev/null > public/sketches.json && echo '📁 スケッチリストを更新しました'",
    "scan:previews": "node scripts/scan-sketches.js --generate-previews",
    "scan:full": "node scripts/scan-sketches.js --generate-previews --fetch-user-data",
    "scan:reset": "rm -rf public/sketches public/previews public/avatars && node scripts/scan-sketches.js --generate-previews --fetch-user-data --force-regenerate && echo '🔄 公開ファイルをリセット・再生成しました'",
    "scan:watch": "nodemon --watch sketches --ext html,js,css --exec \"node scripts/scan-sketches.js --watch-mode 2>/dev/null > public/sketches.json && echo '📁 スケッチリストを更新しました（新規スケッチのプレビューも生成）'\""
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "playwright": "^1.47.0",
    "terser": "^5.43.1",
    "typescript": "~5.8.3",
    "vite": "^7.1.5"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "axios": "^1.13.5",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "ora": "^7.0.1",
    "prompts": "^2.4.2",
    "puppeteer": "^24.16.2"
  }
}
